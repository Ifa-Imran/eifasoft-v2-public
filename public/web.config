<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- ========================================== -->
    <!-- MIME TYPES FOR NEXT.JS                     -->
    <!-- ========================================== -->
    <staticContent>
      <!-- Remove existing MIME type mappings -->
      <remove fileExtension=".css" />
      <remove fileExtension=".js" />
      <remove fileExtension=".json" />
      <remove fileExtension=".mjs" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".map" />
      <remove fileExtension=".avif" />
      <remove fileExtension=".webp" />
      <remove fileExtension=".svg" />
      <remove fileExtension=".ico" />
      
      <!-- Add correct MIME types for Next.js assets -->
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
      
      <!-- Modern image formats -->
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
    </staticContent>

    <!-- ========================================== -->
    <!-- URL REWRITE FOR NEXT.JS ROUTING            -->
    <!-- ========================================== -->
    <rewrite>
      <rules>
        <!-- ONLY: Rewrite non-file requests to index.html -->
        <rule name="Next.js Routes" stopProcessing="true">
          <match url="^(?!_next/|favicon\.ico|robots\.txt|manifest\.webmanifest)(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>

    <!-- ========================================== -->
    <!-- HTTP COMPRESSION                           -->
    <!-- ========================================== -->
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" dynamicLevel="6" staticLevel="7" />
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="message/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/wasm" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- ========================================== -->
    <!-- CACHING HEADERS                            -->
    <!-- ========================================== -->
    <caching>
      <profiles>
        <!-- Static assets - 1 year cache (immutable) -->
        <profile extension=".css" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".js" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".mjs" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".map" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        
        <!-- Images - 1 year cache -->
        <profile extension=".jpg" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".jpeg" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".png" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".gif" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".webp" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".avif" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".svg" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        <profile extension=".ico" kernelCachePolicy="Absolute" expiration="365.00:00:00" location="Any" />
        
        <!-- Data files - 1 day cache -->
        <profile extension=".json" kernelCachePolicy="Absolute" expiration="1.00:00:00" location="Any" />
      </profiles>
    </caching>

    <!-- ========================================== -->
    <!-- SECURITY HEADERS                           -->
    <!-- ========================================== -->
    <httpProtocol>
      <customHeaders>
        <!-- Remove server information -->
        <remove name="X-Powered-By" />
        <remove name="Server" />
        
        <!-- Security headers -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <!-- ========================================== -->
    <!-- OTHER SETTINGS                             -->
    <!-- ========================================== -->
    
    <!-- Disable directory browsing -->
    <directoryBrowse enabled="false" />
    
    <!-- Default document -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    
    <!-- Client-side caching -->
    <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    
    <!-- Error pages - DISABLED to prevent 500 loops -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="404" subStatusCode="-1" />
      <remove statusCode="500" subStatusCode="-1" />
    </httpErrors>
  </system.webServer>
</configuration>
